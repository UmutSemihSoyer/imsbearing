#usda 1.0
(
    customLayerData = {
        string author = "IMS Bearing Digital Twin Engine"
        string generator = "OmniverseUSDExporter v1.0"
    }
    defaultPrim = "IMSBearing_Bearing1_1"
    upAxis = "Y"
)

def Xform "IMSBearing_Bearing1_1" (
    kind = "component"
)
{
    def Mesh "OuterRace"
    {
        color3f[] primvars:displayColor = [(0.9, 0.1, 0.1)]
        double radius = 35.0
        double width = 15.0
        custom float health_index = 0.35
        custom float surface_temp_c = 68.5
    }

    def Material "SpallHeatmapMaterial"
    {
        token outputs:surface.connect = </IMSBearing_Bearing1_1/SpallHeatmapMaterial/PBRShader.outputs:surface>

        def Shader "PBRShader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.9, 0.1, 0.1)
            color3f inputs:emissiveColor = (0.5, 0.0, 0.0)
            float inputs:roughness = 0.2
            float inputs:metallic = 0.95
            token outputs:surface
        }
    }
}
